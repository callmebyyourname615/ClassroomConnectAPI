PORT=3000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000

JWT_SECRET=change-me-in-each-environment
JWT_EXPIRES_IN=30m

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=alphaschool
DB_POOL_MAX=10

TYPEORM_SYNCHRONIZE=false
SLOW_REQUEST_THRESHOLD_MS=500

CACHE_ENABLED=true
CACHE_PREFIX=alphaschool
REDIS_URL=

# Native Android/iOS Push; disabled until Firebase credentials are configured.
MOBILE_PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
# Absolute path to a Firebase service-account JSON kept outside the repository.
GOOGLE_APPLICATION_CREDENTIALS=
# Set an interface reachable by the device when testing on a physical phone.
LISTEN_HOST=127.0.0.1
